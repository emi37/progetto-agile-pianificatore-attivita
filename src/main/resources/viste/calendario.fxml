<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?main scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Vista dedicata al Calendario (Epica 4) -->
<VBox spacing="15.0" stylesheets="@calendario.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.univaq.disim.agile.progetto.agile.pianificatore.attivita.controller.CalendarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        
        <!-- Intestazione con titolo e controlli di vista (Mese/Settimana) -->
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <Label text="Calendario Impegni Personali">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" spacing="10.0">
                    <children>
                        <Label text="Visualizzazione:" />
                        <ComboBox fx:id="vistaComboBox" prefWidth="130.0" promptText="Mese" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Sezione dei filtri richiesti dai criteri di accettazione (es. Priorità Alta) -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="filtri-box">
            <children>
                <Label text="Filtri Rapidi:" style="-fx-font-weight: bold;" />
                <CheckBox fx:id="filtroPrioritaAltaCheckBox" text="Solo Priorità Alta" onAction="#applicaFiltriAction" />
                <Button text="Reset Filtri" onAction="#resetFiltriAction" styleClass="button-secondary" />
            </children>
        </HBox>

        <!-- Area centrale che ospiterà la griglia del calendario -->
        <VBox fx:id="calendarioContainer" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" styleClass="calendario-grid-container">
            <children>
                <!-- Qui dentro il controller caricherà dinamicamente le giornate o la griglia -->
                <Label text="[Griglia Calendario in caricamento...]" textFill="#6c757d">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>

    </children>
</VBox>

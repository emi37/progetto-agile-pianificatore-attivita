<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #f4f6f9;" stylesheets="@calendario.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.univaq.disim.agile.progetto.agile.pianificatore.attivita.controller.CalendarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        
        <!-- intestazione con titolo e il bottone per tornare alla home -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label text="Calendario impegni personali" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                
                <!-- Spacer elastico per spingere il bottone tutto a destra -->
                <Pane HBox.hgrow="ALWAYS" />
                
            <!-- Bottone per tornare alla dashboard/home-->
                <Button onAction="#tornaDashboardAction" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Torna alla home/dashboard" />
            </children>
        </HBox>

        <!-- filtro e la visualizzazione nello stesso box -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #d1d3e2; -fx-border-radius: 8;">
            <children>
                <Label style="-fx-font-weight: bold;" text="Filtro prior. alta" />
                <CheckBox fx:id="filtroPrioritaAltaCheckBox" onAction="#applicaFiltriAction" text="Solo Priorità Alta" />
                <Button onAction="#resetFiltriAction" style="-fx-background-color: #e2e8f0; -fx-cursor: hand;" text="Reset filtro" />
                
                <!-- Spacer elastico per spingere la visualizzazione a destra dentro il box -->
                <Pane HBox.hgrow="ALWAYS" />
                
                <!-- Visualizzazione spostata dentro il box dei filtri -->
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <children>
                        <Label text="Visualizzazione:" />
                        <ComboBox fx:id="vistaComboBox" prefWidth="150.0" promptText="Mese Corrente" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Container Calendario con Sfondo Chiaro -->
        <VBox fx:id="calendarioContainer" alignment="CENTER" prefHeight="450.0" prefWidth="650.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #d1d3e2; -fx-border-radius: 10;" />

    </children>
</VBox>